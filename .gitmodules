[submodule "src/usb/tinyusb"]
	path = src/usb/tinyusb
	url = https://github.com/hathach/tinyusb.git
	ignore = dirty
[submodule "src/wifi/lwip"]
	path = src/wifi/lwip
	url = https://github.com/lwip-tcpip/lwip.git
[submodule "src/fujinet/cJSON"]
	path = src/fujinet/cJSON
	url = https://github.com/DaveGamble/cJSON.git
[submodule "src/wifi/mbedtls"]
	path = src/wifi/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
