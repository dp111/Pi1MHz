From 624af9f12095af60eec1877c18f4c5fdc10045cc Mon Sep 17 00:00:00 2001
From: dp111 <dp111@users.noreply.github.com>
Date: Thu, 22 Oct 2026 11:48:44 +0100
Subject: [PATCH] tcp_in: free undelivered recv_data when the sent callback
 closes the pcb

When a segment both ACKs our data and carries new in-order data,
tcp_receive() moves that data to recv_data before the sent callback
runs.  If the sent callback then closes the pcb (tcp_close() with
unread data sends RST and defers the free to tcp_input_delayed_close())
or aborts it (returns ERR_ABRT), tcp_input() jumps to 'aborted', which
sets recv_data = NULL without freeing it: the pbuf leaks.

A typical trigger is a server that refuses an upload: it answers an
error before reading the request body and closes once the response is
ACKed, while the client is still sending.  Each refused request leaks
one pbuf until PBUF_POOL is exhausted and every received frame is
dropped.

Free recv_data on both paths; it has not been passed to the
application.  Two unit tests cover close and abort from the sent
callback.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WXCX8VH6qZPmvFo4uyP1V5
---
 src/core/tcp_in.c        | 13 ++++++++
 test/unit/tcp/test_tcp.c | 72 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 85 insertions(+)

diff --git a/src/core/tcp_in.c b/src/core/tcp_in.c
index 7c8b71cd..f23fc94c 100644
--- a/src/core/tcp_in.c
+++ b/src/core/tcp_in.c
@@ -467,12 +467,25 @@ tcp_input(struct pbuf *p, struct netif *inp)
 #endif
             TCP_EVENT_SENT(pcb, (u16_t)acked16, err);
             if (err == ERR_ABRT) {
+              /* recv_data has not reached the application: "aborted"
+                 would only forget it and leak the pbuf */
+              if (recv_data != NULL) {
+                pbuf_free(recv_data);
+                recv_data = NULL;
+              }
               goto aborted;
             }
           }
           recv_acked = 0;
         }
         if (tcp_input_delayed_close(pcb)) {
+          /* closed in the sent callback (tcp_close with unread data sends
+             RST and defers the free to here): recv_data has not reached
+             the application, so free it rather than leak the pbuf */
+          if (recv_data != NULL) {
+            pbuf_free(recv_data);
+            recv_data = NULL;
+          }
           goto aborted;
         }
 #if TCP_QUEUE_OOSEQ && LWIP_WND_SCALE
diff --git a/test/unit/tcp/test_tcp.c b/test/unit/tcp/test_tcp.c
index 690ee408..889d6526 100644
--- a/test/unit/tcp/test_tcp.c
+++ b/test/unit/tcp/test_tcp.c
@@ -201,6 +201,76 @@ START_TEST(test_tcp_recv_inseq)
 }
 END_TEST
 
+/** The sent callback closes (or aborts) the pcb while the segment carrying
+ * the ACK also carries in-order data: that data has not reached the
+ * application yet and must not leak (a server refusing an upload closes
+ * when its error response is ACKed, while the client is still sending). */
+static int test_tcp_sent_close_abort;
+static err_t
+test_tcp_sent_close(void *arg, struct tcp_pcb *pcb, u16_t len)
+{
+  LWIP_UNUSED_ARG(arg);
+  LWIP_UNUSED_ARG(len);
+  if (test_tcp_sent_close_abort) {
+    tcp_abort(pcb);
+    return ERR_ABRT;
+  }
+  EXPECT(tcp_close(pcb) == ERR_OK);
+  return ERR_OK;
+}
+
+static void
+test_tcp_rx_data_with_ack_closed_in_sent(int do_abort)
+{
+  struct test_tcp_counters counters;
+  struct tcp_pcb* pcb;
+  struct pbuf* p;
+  char tx_data[] = {'4', '0', '9', '\n'};
+  char rx_data[] = {1, 2, 3, 4};
+  struct netif netif;
+  struct test_tcp_txcounters txcounters;
+
+  test_tcp_init_netif(&netif, &txcounters, &test_local_ip, &test_netmask);
+  memset(&counters, 0, sizeof(counters));
+  pcb = test_tcp_new_counters_pcb(&counters);
+  EXPECT_RET(pcb != NULL);
+  tcp_set_state(pcb, ESTABLISHED, &test_local_ip, &test_remote_ip, TEST_LOCAL_PORT, TEST_REMOTE_PORT);
+  pcb->mss = TCP_MSS;
+  /* disable initial congestion window (we don't send a SYN here...) */
+  pcb->cwnd = pcb->snd_wnd;
+  test_tcp_sent_close_abort = do_abort;
+  tcp_sent(pcb, test_tcp_sent_close);
+
+  /* our response, for the peer to ACK */
+  EXPECT_RET(tcp_write(pcb, tx_data, sizeof(tx_data), TCP_WRITE_FLAG_COPY) == ERR_OK);
+  EXPECT_RET(tcp_output(pcb) == ERR_OK);
+  EXPECT(MEMP_STATS_GET(used, MEMP_PBUF_POOL) == 0);
+
+  /* the peer ACKs it in the same segment as more of its own data */
+  p = tcp_create_rx_segment(pcb, rx_data, sizeof(rx_data), 0, pcb->snd_nxt - pcb->lastack, TCP_ACK);
+  EXPECT_RET(p != NULL);
+  test_tcp_input(p, &netif);
+
+  EXPECT(counters.recv_calls == 0);
+  EXPECT(MEMP_STATS_GET(used, MEMP_TCP_PCB) == 0);
+  /* the segment's data must have been freed with the pcb */
+  EXPECT(MEMP_STATS_GET(used, MEMP_PBUF_POOL) == 0);
+}
+
+START_TEST(test_tcp_rx_data_with_ack_close_in_sent)
+{
+  LWIP_UNUSED_ARG(_i);
+  test_tcp_rx_data_with_ack_closed_in_sent(0);
+}
+END_TEST
+
+START_TEST(test_tcp_rx_data_with_ack_abort_in_sent)
+{
+  LWIP_UNUSED_ARG(_i);
+  test_tcp_rx_data_with_ack_closed_in_sent(1);
+}
+END_TEST
+
 /** Create an ESTABLISHED pcb and check if receive callback is called if a segment
  * overlapping rcv_nxt is received */
 START_TEST(test_tcp_recv_inseq_trim)
@@ -1676,6 +1746,8 @@ tcp_suite(void)
     TESTFUNC(test_tcp_listen_passive_open),
     TESTFUNC(test_tcp_recv_inseq),
     TESTFUNC(test_tcp_recv_inseq_trim),
+    TESTFUNC(test_tcp_rx_data_with_ack_close_in_sent),
+    TESTFUNC(test_tcp_rx_data_with_ack_abort_in_sent),
     TESTFUNC(test_tcp_passive_close),
     TESTFUNC(test_tcp_active_abort),
     TESTFUNC(test_tcp_malformed_header),
-- 
