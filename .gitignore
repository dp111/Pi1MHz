# Machine-specific GCC-17 build wrapper. Needs a toolchain that only exists
# on the build host (/root/gcc17/toolchain-consolidated), so it is deliberately
# not committed. Its companion toolchain-gcc17-allpatches.cmake is already
# covered by the *.cmake rule above.
/build-gcc17.sh

# Local working notes - review documents and the Claude session runbook.
# Kept on disk for the sessions that use them, never for upstream.
/PI-CONTROL.md
/src/*Code_Review*.md
/src/*code_review*.md
/src/*compliance*.md

# Only firmware/kernel.img and firmware/kernel7.img ship in the repo.
# Debug builds and experimental image variants stay local.
/firmware/debug/kernel.img
/firmware/debug/kernel7.img
/firmware/kernel.*.img
/firmware/kernel7.*.img
__pycache__/
