00: "org0001:0" (0-15A)


Source: "Pi1MHzvc.s"
                            	     1: #-------------------------------------------------------------------------
                            	     2: # VideoCore IV implementation of 1MHz handler
                            	     3: #-------------------------------------------------------------------------
                            	     4: 
                            	     5: # on entry
                            	     6: # GPIO pins setup by arm
                            	     7: # Addresses passed into vc are VC based
                            	     8: # gpfsel_data_idle setup
                            	     9: 
                            	    10: #  r0 - pointer to shared memory ( VC address) of 1MHz registers
                            	    11: #  r1 - pointer to data to xfer to ARM
                            	    12: #  r2 - nOE pin
                            	    13: #  r3 - data outputs
                            	    14: #  r4 - debug output control
                            	    15: #  r5 - debug pin mask (0 = no debug  xx= debug pin e.g 1<<21)
                            	    16: 
                            	    17: # Internal register allocation
                            	    18: #  r0 - pointer to shared memory ( VC address) of tube registers
                            	    19: #  r1 - pointer to data to xfer to ARM
                            	    20: #  r2 - External nOE pin
                            	    21: #  r3 - Databus and test pin output select
                            	    22: #  r4 - debug output control
                            	    23: #  r5 - debug pin mask (0 = no debug  xx= debug pin e.g 1<<21)
                            	    24: #  r6 - GPFSEL0 constant
                            	    25: #  r7 -
                            	    26: #  r8 - temp
                            	    27: #  r9 -
                            	    28: # r10 -
                            	    29: # r11 -
                            	    30: # r12 - GPIO pins value
                            	    31: # r13 - pointer to doorbell register
                            	    32: # r14 -
                            	    33: # r15 -
                            	    34: 
                            	    35: # GPIO registers
                            	    36: .equ GPFSEL0,       0x7e200000
                            	    37: .equ GPFSEL0_offset, 0
                            	    38: .equ GPSET0_offset, 0x1C
                            	    39: .equ GPCLR0_offset, 0x28
                            	    40: .equ GPLEV0_offset, 0x34
                            	    41: .equ GPEDS0_offset, 0x40
                            	    42: 
                            	    43: # Post ring (docs/dev/bus-post-ring.md).  Each bus cycle's GPIO sample goes
                            	    44: # into one of 8 consecutive registers (SMI DSR0..DSW3, 0x7E600010..2C) with
                            	    45: # a 5-bit sequence tag in bits 27-31 (GPIO 27 is CLK, which the ARM never
                            	    46: # reads from the sample; GPIO 28-31 are not on the bus), then
                            	    47: # the doorbell rings.  The ARM FIQ acknowledges the bell first and drains
                            	    48: # every slot whose tag matches its own sequence.  Nothing here reads a
                            	    49: # register: two stores per post, as before.
                            	    50: #  r1  - ring base, passed by the ARM at launch (it was the single post word
                            	    51: #        before the ring, so the launch parameter did not change)
                            	    52: #  r10 - the next tag, pre-shifted to bits 27-31 (add TAG_STEP to advance);
                            	    53: #        bits 27-29 are the slot, bits 30-31 the lap, so the ARM can tell
                            	    54: #        "last lap, not written yet" from "the VPU is a lap ahead"
                            	    55: #  r11 - word index of the next slot, 0..7 (st rX,(ra,rb) scales rb by 4,
                            	    56: #        like ld r8,(r0,r8) below)
                            	    57: #  The sample's GPIO 27-31 are dropped with extu rX,27 before the tag goes in.
                            	    58: .equ TAG_STEP,  0x08000000
                            	    59: 
                            	    60: # fixed pin bit positions ( TEST passed in dynamically)
                            	    61: .equ nRST,         26
                            	    62: .equ nPCFD,        25
                            	    63: .equ nPCFC,        24
                            	    64: 
                            	    65: .equ RnW,          10
                            	    66: .equ CLK,          27
                            	    67: .equ DATASHIFT,    2
                            	    68: .equ ADDRBUS_SHIFT, (16)
                            	    69: .equ OUTPUTBIT,   (15)
                            	    70: 
                            	    71: .equ ADDRESSBUS_WIDTH, (8 + 1)
                            	    72: .equ DATABUS_WIDTH, 8
                            	    73: 
                            	    74: .equ NPCFC_MASK,    (1<<nPCFC)
                            	    75: 
                            	    76: .equ Pi1MHz_MEM_RNW, (1<<9)
                            	    77: 
                            	    78: .equ GPU_ARM_DBELL, 0x7E00B844
                            	    79: 
                            	    80: .org 0                     # NB all code relative
                            	    81: 
00:00000000 0500            	    82:    di                      # disable interrupts
00:00000002 434D            	    83:    or     r3, r4           # add in test pin so that it is still enabled
00:00000004 06E80000207E    	    84:    mov    r6, GPFSEL0
                            	    85: 
00:0000000A 0DE844B8007E    	    86:    mov    r13, GPU_ARM_DBELL
00:00000010 0A60            	    87:    mov    r10, 0                 # post ring: first tag is 0 (the ARM starts at sequence 0)
00:00000012 0B60            	    88:    mov    r11, 0                 # ... first slot (the base is r1, from the ARM)
00:00000014 026A            	    89:    cmp    r2, 0
00:00000016 00914D00        	    90:    bne    use_nOE
00:0000001A 031F            	    91:    BEQ    Poll_loop
                            	    92: 
                            	    93: # poll for nPCFC or nPCFD being low
                            	    94: .balignw 16,1 # Align with nops
                            	    95: Poll_loop:
                            	    96:    # st     r5, GPCLR0_offset(r6)  # Turn off debug signal
                            	    97: 
                            	    98: Poll_access_low:
00:00000020 6C2D            	    99:    ld     r12, GPLEV0_offset(r6)  # loop until we see FRED or JIM low
                            	   100: 
00:00000022 8C6D            	   101:    btst   r12, nPCFC
00:00000024 8CC1D960        	   102:    btstne r12, nPCFD
00:00000028 FC18            	   103:    bne    Poll_access_low
                            	   104: 
                            	   105:    # st     r5, GPSET0_offset(r6)  # Debug pin
                            	   106: 
00:0000002A BC6D            	   107:    btst   r12, CLK
00:0000002C 0A18            	   108:    beq    waitforclkhigh
                            	   109: 
                            	   110: waitforclklow:                   # wait for extra half cycle to end
00:0000002E 6C2D            	   111:    ld     r12, GPLEV0_offset(r6)
00:00000030 8C6D            	   112:    btst   r12, nPCFC
00:00000032 8CC1D960        	   113:    btstne r12, nPCFD
00:00000036 F518            	   114:    bne    Poll_loop
                            	   115: 
00:00000038 BC6D            	   116:    btst   r12, CLK
00:0000003A FA18            	   117:    bne    waitforclklow
                            	   118: 
                            	   119: .balignw 16,1 # Align with nops
                            	   120: waitforclkhigh:
                            	   121: waitforclkhighloop:
00:00000040 48C35167        	   122:    LSR    r8, r12,ADDRBUS_SHIFT+1
00:00000044 6C2D            	   123:    ld     r12, GPLEV0_offset(r6)
00:00000046 886E            	   124:    extu   r8, ADDRESSBUS_WIDTH-1   # bmask Isolate address bus
00:00000048 08A00807        	   125:    ld     r8, (r0,r8)            # get byte to write out
                            	   126: 
00:0000004C BC6D            	   127:    btst   r12, CLK
00:0000004E 7918            	   128:    beq    waitforclkhighloop
                            	   129: 
                            	   130: # seen rising edge of CLK
                            	   131: # so address bus has now been setup
                            	   132: 
00:00000050 8C6D            	   133:    btst   r12, nPCFC
00:00000052 8CC1D960        	   134:    btstne r12, nPCFD
00:00000056 E518            	   135:    bne    Poll_loop
                            	   136: 
                            	   137: # check if we are in a read or write cycle
                            	   138: # we do this here while the read above is stalling
                            	   139: 
00:00000058 AC6C            	   140:    btst   r12, RnW
                            	   141:   # lsl    r8, DATASHIFT
00:0000005A 1B18            	   142:    beq    writecycle
                            	   143: 
00:0000005C 0C6D            	   144:    btst   r12, ADDRBUS_SHIFT     # select which 16bits hold the data
00:0000005E 48C3CE40        	   145:    lsrne  r8, 16 - DATASHIFT     # High 16 bits to low 16 bits with databus shift
00:00000062 88C34240        	   146:    lsleq  r8, DATASHIFT          # low 16 bits with databus shift
                            	   147: 
                            	   148:   # btst   r8, OUTPUTBIT
00:00000066 A86E            	   149:    extu   r8, DATABUS_WIDTH + DATASHIFT      # bmask isolate the databus NB lower bit are already zero form above
                            	   150: 
00:00000068 6837            	   151:    st     r8, GPSET0_offset(r6)  # set up databus
00:0000006A 6330            	   152:    st     r3, GPFSEL0_offset(r6) # set databus to output
00:0000006C BC6F            	   153:    extu   r12, 27                # post: drop GPIO 27-31 ...
00:0000006E AC4D            	   154:    or     r12, r10               # ... tag it ...
00:00000070 2CA00B0F        	   155:    st     r12, (r1, r11)        # ... store the entry (rb scaled by 4, as ld r8,(r0,r8) above) ...
00:00000074 DC09            	   156:    st     r12, (r13)             # ... ring the doorbell
00:00000076 4AE800000008    	   157:    add    r10, TAG_STEP          # next tag (wraps through bit 31)
00:0000007C 1B62            	   158:    add    r11, 1
00:0000007E 3B6E            	   159:    extu   r11, 3                 # next slot, 0..7
                            	   160: 
                            	   161: waitforclklow2loop:
00:00000080 6C2D            	   162:    ld     r12, GPLEV0_offset(r6)
00:00000082 BC6D            	   163:    btst   r12, CLK
00:00000084 FE18            	   164:    bne    waitforclklow2loop
                            	   165: 
00:00000086 6430            	   166:    st     r4, GPFSEL0_offset(r6) # data bus to inputs except debug
00:00000088 683A            	   167:    st     r8, GPCLR0_offset(r6)  # clear databus low
                            	   168: 
00:0000008A 4B1F            	   169:    b      Poll_loop
                            	   170: 
                            	   171: .balignw 16,1 # Align with nops
                            	   172: writecycle:
                            	   173: waitforclkloww2:
00:00000090 C840            	   174:    mov    r8,r12
00:00000092 6C2D            	   175:    ld     r12, GPLEV0_offset(r6)
00:00000094 BC6D            	   176:    btst   r12, CLK
00:00000096 FD18            	   177:    bne    waitforclkloww2
                            	   178: 
00:00000098 B86F            	   179:    extu   r8, 27                 # post: drop GPIO 27-31, tag, store, ring (see the read path)
00:0000009A A84D            	   180:    or     r8, r10
00:0000009C 28A00B0F        	   181:    st     r8, (r1, r11)
00:000000A0 D809            	   182:    st     r8, (r13)              # ring doorbell
00:000000A2 4AE800000008    	   183:    add    r10, TAG_STEP
00:000000A8 1B62            	   184:    add    r11, 1
00:000000AA 3B6E            	   185:    extu   r11, 3
00:000000AC 7F9EBAFF        	   186:    b      Poll_loop
