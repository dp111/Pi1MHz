Windows Registry Editor Version 5.00

; A PuTTY saved session "BBC Micro telnet": telnet to the Pi1MHz's TelnetD as host "Pi1MHz" (change Host Name in
; PuTTY for an IP address), 80 x 32, the "BBC Micro MOS" font (install it first: ..\windows\install.cmd), the BBC's
; colours, UTF-8 (the pound sign and teletext graphics), and function keys as ESC [ n ~ (F12 is BREAK).
; Double-click to add it; it appears in PuTTY's Saved Sessions list.

[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\BBC%20Micro%20telnet]
"HostName"="Pi1MHz"
"Protocol"="telnet"
"PortNumber"=dword:00000017
"TermWidth"=dword:00000050
"TermHeight"=dword:00000020
"Font"="BBC Micro MOS"
"FontHeight"=dword:0000000c
"FontIsBold"=dword:00000000
"FontCharSet"=dword:00000000
"FontQuality"=dword:00000001
"LineCodePage"="UTF-8"
"FunctionKeys"=dword:00000000
"BackspaceIsDelete"=dword:00000001
"LocalEcho"=dword:00000002
"LocalEdit"=dword:00000002
"CurType"=dword:00000000
"BlinkCur"=dword:00000000
"BoldAsColour"=dword:00000001
"WinTitle"="BBC Micro - telnet"
"Colour0"="255,255,255"
"Colour1"="255,255,255"
"Colour2"="0,0,0"
"Colour3"="0,0,0"
"Colour4"="0,0,0"
"Colour5"="255,255,255"
"Colour6"="0,0,0"
"Colour7"="0,0,0"
"Colour8"="255,0,0"
"Colour9"="255,0,0"
"Colour10"="0,255,0"
"Colour11"="0,255,0"
"Colour12"="255,255,0"
"Colour13"="255,255,0"
"Colour14"="0,0,255"
"Colour15"="0,0,255"
"Colour16"="255,0,255"
"Colour17"="255,0,255"
"Colour18"="0,255,255"
"Colour19"="0,255,255"
"Colour20"="255,255,255"
"Colour21"="255,255,255"
